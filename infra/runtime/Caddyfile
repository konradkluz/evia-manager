# Edge Caddy of staging (EVM-007 AC4, AC5, AC6; ADR-0018 "DNS, TLS i poczta"; security-engineer B "Caddy"; SR-INFRA-06).
# Installed only in an IaC session at /etc/evia/caddy/Caddyfile. TLS only from Let's Encrypt (the CAA record of the node
# allows that issuer only), HSTS, no Server header, the admin API on localhost inside the container (never published).
# Routing comes from upstream.caddy written by deploy.sh from a fixed template — only the colour (blue|green) changes:
# /healthz -> /api/health and /version -> /api/version of the active API, /api/* -> API, the rest -> the panel (evia-web,
# which serves the CSP and the other headers of the panel itself).
{
	admin localhost:2019
	persist_config off
	servers {
		protocols h1 h2
	}
}

# Access log (EVM-085 AC6, AC7; security-engineer A11; SR-LOG-02, ADR-0013): deny-by-default. Request headers, response headers
# and TLS details are deleted WHOLE (so X-CSRF-Token, Cookie, Authorization and any unknown header never reach the log), the query is
# cut from every URI (not only the activation one), the port is dropped and the addresses are masked to /24 and /48 (policy P9).
# Requests of /api/v1/auth/activation/* are not logged at all (stricter than a redacted path; the API logs the attempt without the
# token). No log_credentials. The log goes to stdout, the journald driver of Docker, Alloy (allow-list of services) and Loki.
# Tested with the REAL snippet text: infra/observability/test/caddy-log.test.sh (service caddy-log-test).
(access_log) {
	@activation path /api/v1/auth/activation/*
	log_skip @activation
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				request>remote_port delete
				resp_headers delete
				request>uri regexp "\?.*" ""
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
			}
		}
	}
}

staging.eviacharge.pl {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	import access_log
	import /etc/caddy/upstream.caddy
}
