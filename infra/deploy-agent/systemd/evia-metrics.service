# EVM-085 AC2 (security A10): the metrics of the deployment channel for the textfile collector, every minute.
[Unit]
Description=EVia metrics of the deployment channel
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/evia-metrics
TimeoutStartSec=2min

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
