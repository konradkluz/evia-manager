# EVM-084 AC2 (ADR-0009): the daily copy of the media to the Storage Box (rclone crypt).
[Unit]
Description=EVia backup: copy of the media to the Storage Box
After=docker.service network-online.target
Wants=network-online.target
OnFailure=evia-restore-alert.service

[Service]
Type=oneshot
EnvironmentFile=/etc/evia/restore/restore.conf
ExecStart=/usr/local/sbin/evia-media-copy
TimeoutStartSec=4h

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
