# EVM-084 AC1 (ADR-0011): the weekly full backup of the database; a failed run is a local event and a metric (backup.sh), the alert is EVM-085.
[Unit]
Description=EVia backup: full backup of the database
After=docker.service network-online.target
Wants=network-online.target
OnFailure=evia-restore-alert.service

[Service]
Type=oneshot
EnvironmentFile=/etc/evia/restore/restore.conf
ExecStart=/usr/local/sbin/evia-backup full
TimeoutStartSec=3h

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
