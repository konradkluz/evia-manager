# EVM-007 AC7 (SR-INFRA-05; security-engineer review round 1): after every boot /run is empty — the tmpfs copies of the
# service secrets (/run/evia/secrets/<service>/, including PostgreSQL and the API manifest hash of the registry) are
# restored BEFORE Docker starts the containers with restart: unless-stopped. Fail-closed: without the secrets Docker does
# not start (no container with empty, root-created directories, no workaround with secrets in environment variables);
# the failure raises the local alert. Installed in the IaC session at /etc/systemd/system/.
[Unit]
Description=EVia: tmpfs copies of the service secrets before Docker (EVM-007 AC7)
Before=docker.service
After=local-fs.target systemd-tmpfiles-setup.service
RequiresMountsFor=/etc/evia/secrets /run/evia /var/lib/evia
OnFailure=evia-deploy-agent-alert.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/evia-secrets

[Install]
WantedBy=multi-user.target
RequiredBy=docker.service
