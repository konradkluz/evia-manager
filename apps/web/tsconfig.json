{
  "extends": "@evia/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "security-headers.ts", "*.config.ts", "*.config.js"],
  "exclude": ["node_modules", "dist", "coverage"]
}
