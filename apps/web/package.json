{
  "name": "@evia/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "EVia Manager office panel — React 19 + Vite 8 SPA with TanStack Router and Query, i18next (pl) and the client generated from the API contract (ADR-0006; EVM-008).",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --grep-invert @screenshots",
    "e2e:screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@evia/contracts": "workspace:*",
    "@evia/ui-web": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15"
  },
  "devDependencies": {
    "@evia/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "4.13.0",
    "eslint": "catalog:",
    "jsdom": "30.1.1",
    "typescript": "catalog:",
    "vite": "8.3.2",
    "vitest": "catalog:"
  }
}
