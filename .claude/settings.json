{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*service-account*.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(docker run:*)",
      "Bash(docker exec:*)",
      "Bash(docker cp:*)",
      "Bash(docker compose -f compose.dev.yaml run:*)",
      "Bash(docker compose -f compose.dev.yaml exec:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --all:*)",
      "Bash(git push --tags:*)",
      "Bash(git push origin HEAD:refs/heads/main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin +*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --no-verify:*)",
      "Read(~/.ssh/**)",
      "Bash(*gh* auth token*)",
      "Bash(*gh* auth status *-t*)",
      "Bash(*gh* auth git-credential*)",
      "PowerShell(*gh* auth token*)",
      "PowerShell(*gh* auth status *-t*)",
      "PowerShell(*gh* auth git-credential*)"
    ],
    "allow": [
      "Bash(docker compose -f compose.yaml run --rm backend-install)",
      "Bash(docker compose -f compose.yaml run --rm backend-tests pnpm run gate:backend)",
      "Bash(docker compose -f compose.yaml run --rm backend-tests pnpm run test:backend:*)",
      "Bash(pnpm run gate)",
      "Bash(pnpm run scan)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(**/compose*.yaml)",
      "Write(**/compose*.yaml)",
      "Edit(**/compose*.yml)",
      "Write(**/compose*.yml)",
      "Edit(**/docker-compose*.yaml)",
      "Write(**/docker-compose*.yaml)",
      "Edit(**/docker-compose*.yml)",
      "Write(**/docker-compose*.yml)",
      "Bash(pnpm run dev:reset:*)",
      "PowerShell(pnpm run dev:reset:*)",
      "Bash(pnpm dev:reset:*)",
      "PowerShell(pnpm dev:reset:*)",
      "Bash(node tools/dev-env/cli.mjs reset:*)",
      "PowerShell(node tools/dev-env/cli.mjs reset:*)",
      "Bash(docker compose -f compose.dev.yaml down -v:*)",
      "PowerShell(docker compose -f compose.dev.yaml down -v:*)"
    ]
  }
}
