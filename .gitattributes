# Line endings (ADR-0015, EVM-006): LF in the index and in every working tree, also on Windows.
* text=auto eol=lf

# Binary files — never normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.mov binary

# Gradle wrapper of the Kotlin upload engine (EVM-109): the shell script keeps LF (it runs on Linux CI), the batch file CRLF, the jar is binary
# (its SHA-256 is pinned by tools/repo-policy against the official checksum of gradle.org).
*.jar binary
apps/mobile/modules/evia-upload/engine/gradlew text eol=lf
*.bat text eol=crlf
