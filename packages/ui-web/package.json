{
  "name": "@evia/ui-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web UI component library of EVia Manager: Tailwind CSS 4 theme mapped from @evia/tokens and shell components per styleguide (ADR-0006; EVM-008).",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@evia/tokens": "workspace:*",
    "lucide-react": "1.50.0",
    "tailwindcss": "4.3.3"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@evia/config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "4.13.0",
    "eslint": "catalog:",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
