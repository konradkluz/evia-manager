{
  "$comment": "Emits the published API of the package (generated code + entry points) to dist/ as JavaScript with declarations.",
  "extends": "@evia/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["es2024", "dom"],
    "types": []
  },
  "include": ["src/index.ts", "src/zod.ts", "src/authz.ts", "src/public-operations.ts", "generated/**/*.ts"]
}
