{
  "name": "@evia/sync-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Durable mutation queue and sync engine of the mobile app (EVM-091; ADR-0007, offline-sync.md): pure TypeScript behind ports, no runtime dependencies, no React Native, no Node built-ins.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./conformance/replica": {
      "types": "./conformance/replica.ts",
      "default": "./conformance/replica.ts"
    },
    "./conformance/queue": {
      "types": "./conformance/queue.ts",
      "default": "./conformance/queue.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@evia/config": "workspace:*",
    "@evia/contracts": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
