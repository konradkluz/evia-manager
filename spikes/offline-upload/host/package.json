{
  "name": "@evm011/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Host-side tools of the spike: url-issuer (stand-in for the API), scripts and integration tests. @aws-sdk lives here only, never in the app.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@aws-sdk/s3-request-presigner": "3.1153.0",
    "@evm011/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
