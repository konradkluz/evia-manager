# EVia Manager — przykładowa konfiguracja lokalna (EVM-006 AC5; SR-INFRA-05, ADR-0015 M2).
#
# Zasady:
# - Ten plik zawiera WYŁĄCZNIE nazwy zmiennych i wartości przykładowe — nigdy prawdziwych sekretów.
# - Lokalne wartości trzymaj w .env (ignorowany przez git) — tylko syntetyczne sekrety deweloperskie
#   (np. hasło lokalnej bazy w kontenerze).
# - Sekrety usług zewnętrznych (GitHub, Expo, Scaleway, Sentry, Grafana, konta Apple/Google) NIGDY w katalogu
#   repozytorium, także nie w plikach ignorowanych — menedżer sekretów albo %USERPROFILE%\.evia\.
# - Każda nowa zmienna trafia tutaj z opisem (docs/process/conventions.md → „Kod”).
#
# EVM-006: aplikacja nie ma jeszcze zmiennych konfiguracyjnych — dopisują je EVM-007, EVM-008 i EVM-009.

# --- API (apps/api, EVM-008) — walidowane przy starcie; błąd podaje tylko nazwę zmiennej ---
# Środowisko: development | test | production (domyślnie production). LOG_LEVEL debug/trace tylko w development.
NODE_ENV=development
# Port HTTP API (domyślnie 3000).
API_PORT=3000
# Poziom logów: fatal | error | warn | info | debug | trace (domyślnie info).
LOG_LEVEL=info
# Połączenie z lokalną bazą dev (EVM-077): PostgreSQL 18 z compose.dev.yaml, opublikowana wyłącznie na 127.0.0.1:5442, baza evia_dev,
# syntetyczne hasło (nie sekret). Strażnik narzędzi dev odmawia każdego innego adresu (inny host, baza, port, parametry zapytania).
# Usługa `postgres` z compose.yaml służy tylko testom (sieć wewnętrzna, bez portów, baza w pamięci).
DATABASE_URL=postgres://evia:evia-local@localhost:5442/evia_dev
# Minimalna wspierana wersja aplikacji mobilnej (semver MAJOR.MINOR.PATCH) — zwracana przez GET /api/health
# (od EVM-009 także meta/client-config i 426 dla starszych wersji).
MIN_SUPPORTED_APP_VERSION_ANDROID=1.0.0
MIN_SUPPORTED_APP_VERSION_IOS=1.0.0

# --- Tożsamość i panel (EVM-016) ---
# Origin panelu web (schemat + host [+ port], bez ścieżki): oczekiwany w kontroli CSRF (nagłówek Origin) i w WebAuthn;
# adres linku aktywacyjnego to PANEL_ORIGIN + /activate#<token>. Na produkcji tylko https i nie localhost.
# Ciasteczko sesji jest zawsze Secure z prefiksem __Host- — nie ma przełącznika; lokalnie localhost (kontekst bezpieczny) albo HTTPS.
PANEL_ORIGIN=http://localhost:5173
# Identyfikator relying party kluczy dostępu: host panelu albo jego domena nadrzędna (nie bierze się z nagłówka Host).
# Zmiana po rejestracji kluczy unieważnia je — ustal przed pierwszym użyciem (domena stagingu: EVM-007).
WEBAUTHN_RP_ID=localhost
# Nazwa serwisu pokazywana przy rejestracji klucza dostępu (opcjonalna; domyślnie "EVia Manager").
WEBAUTHN_RP_NAME=EVia Manager
# Adresy lub zakresy CIDR reverse proxy, którym wierzymy w X-Forwarded-For (po przecinku; domyślnie pusta lista = nagłówek
# ignorowany, adres klienta to adres połączenia). Wpisz tylko znane proxy (Caddy), inaczej klient podrobi adres w limitach i audycie.
TRUSTED_PROXIES=

# --- Zlecenia (EVM-017) ---
# Klucz kursorów paginacji (AES-256-GCM): dokładnie 32 bajty w base64url (43 znaki), WYMAGANY w każdym środowisku — bez niego API
# i polecenia CLI nie wystartują. Osobny sekret tylko dla kursorów; wartość nie ma domyślnej (pusta = błąd konfiguracji) — wygeneruj
# losowo i wpisz do lokalnego .env: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Produkcja odrzuca klucz-zaślepkę (powtarzający się bajt, same zera). Zmiana klucza unieważnia wydane kursory (panel wraca na
# pierwszą stronę listy). Wymagają go: serwer API, worker i polecenia CLI; `db:migrate` — NIE (EVM-080).
CURSOR_KEY=

# --- Kod z aplikacji (TOTP) i kody odzyskiwania (EVM-023) ---
# Klucze główne szyfrowania kopertowego pól bazy (sekret TOTP; SR-CRYPTO-02): lista `id:klucz`, klucz = dokładnie 32 bajty w base64url
# (43 znaki), id = [a-z0-9-], do 16 znaków; pierwszy klucz szyfruje, wszystkie odszyfrowują (rotacja: nowy na początek, stary zostaje, aż żaden
# wiersz go nie używa). Przykład: FIELD_ENCRYPTION_KEYS=k1:<43 znaki>. WYMAGANY w produkcji (brak, zaślepka, zła długość albo powtórzone id
# = błąd startu; osobny od CURSOR_KEY). Poza produkcją pusty = konfiguracja kodu z aplikacji jest niedostępna (503), nic nie jest zapisywane
# jawnie. Utrata klucza = utrata dostępu wszystkich użytkowników z TOTP (ich sekretów nie da się odszyfrować): klucz trafia do inwentarza kluczy
# (SR-CRYPTO-04), kopii w Bitwarden i zestawu offline (EVM-007). Wygeneruj losowo: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64url'))"
FIELD_ENCRYPTION_KEYS=

# --- Synchronizacja telefonów (EVM-096; ADR-0021 D6) ---
# Pierścień kluczy kursora pobierania zmian: lista `id:klucz` (jak FIELD_ENCRYPTION_KEYS), klucz = 32 bajty w base64url (43 znaki); pierwszy klucz
# szyfruje, wszystkie otwierają (rotacja planowa: nowy na początek, stary zostaje co najmniej 90 dni; kompromitacja: natychmiast usuń stary — telefony
# zrobią resync). Gdy podany: zaślepka (produkcja), powtórzone id albo klucz równy CURSOR_KEY / kluczowi pól = błąd startu. Pusty = JEDEN klucz
# pochodny od CURSOR_KEY (HMAC z etykietą; bez rotacji pierścienia) — zalecane ustawienie jawnego pierścienia na stagingu i produkcji. Inwentarz kluczy: docs/ops/rotacja-sekretow.md. Wygeneruj losowo: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64url'))"
SYNC_CURSOR_KEYS=
# Opcjonalne (wartości domyślne w nawiasach; po zmianie zakresu podnieś SYNC_SCOPE_RULE_VERSION — telefony zrobią resync):
# SYNC_CLOSED_ORDERS_IN_SCOPE_DAYS=30   zamknięte zlecenia w zakresie telefonu (N dni)
# SYNC_PERIODIC_RESYNC_DAYS=7           kontrolny resync
# SYNC_SCOPE_RULE_VERSION=1             wersja reguły zakresu
# SYNC_FULL_DOWNLOADS_PER_DAY=3         pełne pobrania urządzenia w kroczącej dobie (powyżej: 429)
# SYNC_PAGE_MAX_BYTES=900000            strona zmian kończy się przed tym rozmiarem odpowiedzi

# --- Ochrona przed zgadywaniem haseł (EVM-026) ---
# Klucz HMAC-SHA-256 liczników prób logowania (zamiast e-maila w bazie): co najmniej 32 bajty w base64url, osobny sekret (różny od CURSOR_KEY
# i od kluczy FIELD_ENCRYPTION_KEYS). WYMAGANY w produkcji (brak, zaślepka albo powtórzenie innego klucza = błąd startu); poza produkcją pusty =
# losowy klucz procesu (po restarcie liczniki z poprzedniego procesu nie są odnajdywane — wygodne w dev, niedopuszczalne na serwerze).
# Zmiana klucza zeruje liczniki i blokady w toku. Wygeneruj losowo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LOGIN_THROTTLE_KEY=
# Progi alertów (SR-LOG-07; opcjonalne): więcej niż tyle nieudanych haseł wszystkich kont w 5 minut (domyślnie 30, poziom warning) i co najmniej
# tyle porażek drugiego kroku jednego zakresu w jego oknie 15 minut (domyślnie 3, poziom critical).
LOGIN_ALERT_PASSWORD_FAILURES=30
LOGIN_ALERT_SECOND_STEP_FAILURES=3

# --- E-mail transakcyjny (EVM-024) — tylko worker (apps/api/src/worker.ts); serwer API i polecenia CLI nie czytają tych zmiennych ---
# Transport e-maila: smtp | none. WYMAGANY, bez wartości domyślnej (brak = błąd startu workera; zasada fail-closed).
#   smtp — wysyłka SMTP do Mailpit (dev, compose.dev.yaml); ODRZUCANE przy NODE_ENV=production (czyli też na stagingu i przy braku
#          NODE_ENV) — staging i produkcja wysyłają przez dostawcę z EVM-089, nie przez SMTP;
#   none — worker niczego nie wysyła ani nie przekazuje do kolejki: e-maile czekają w skrzynce nadawczej (platform.email_outbox, stan
#          pending) bez utraty, log workera zgłasza błąd, a healthcheck workera jest czerwony. Jawne w każdym środowisku.
EMAIL_TRANSPORT=smtp
# Host i port SMTP (przy smtp, oba wymagane). Host tylko z listy: mailpit | localhost | 127.0.0.1 | ::1 — inny host to błąd konfiguracji
# (dev nie wyśle poczty do zewnętrznego przekaźnika). Bez loginu i hasła: w tej historyjce nie ma sekretów SMTP.
# Przy uruchomieniu workera poza kontenerem: Mailpit opublikowany na 127.0.0.1:1025; w compose.dev.yaml worker używa nazwy usługi (mailpit).
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
# Adres nadawcy (sam adres, bez nazwy; nazwa „EVia Manager” jest stała w kodzie). Przy smtp wymagany.
EMAIL_FROM=noreply@evia-manager.localhost

# --- Rejestr usunięć poza bazą (EVM-040; SR-PRIV-04) — bucket evia-staging-deletion-register z EVM-084 (klucz aplikacji tylko PutObject) ---
# Pięć zmiennych działa WSZYSTKIE ALBO ŻADNA. Brak wszystkich = rejestr niedostępny (ostrzeżenie przy starcie); zestaw niepełny albo zły format =
# błąd w logu z NAZWAMI zmiennych (bez wartości). Nigdy nie zatrzymuje startu (wdrożenie stagingu nie może zależeć od bucketu): redakcja treści
# wpisu dziennika odpowiada wtedy 503 deletion_register_unavailable (fail-closed), reszta usługi działa. Poświadczenia są podawane jawnie —
# zmienne AWS_* i ~/.aws nie są czytane. S3_ENDPOINT: https (http tylko dla loopback poza produkcją, w testach).
S3_ENDPOINT=
S3_REGION=
DELETION_REGISTER_BUCKET=
DELETION_REGISTER_S3_ACCESS_KEY_ID=
# Sekret: na stagingu z pliku (DELETION_REGISTER_S3_SECRET_ACCESS_KEY_FILE); bez wartości w repozytorium.
DELETION_REGISTER_S3_SECRET_ACCESS_KEY=

# --- Wydanie i sekrety z plików (EVM-007) — kanał wdrożeń stagingu; lokalnie zostaw puste ---
# Commit wydania: ustawiany w obrazie API przy budowie (ARG -> ENV, nie sekret); zwraca go GET /api/version. Pusty = null.
EVIA_RELEASE_COMMIT=
# SHA-256 (hex) dokładnych bajtów release-manifest.json wydania; na stagingu z pliku (EVIA_RELEASE_MANIFEST_SHA256_FILE). Pusty = null.
EVIA_RELEASE_MANIFEST_SHA256=
# Zamiast wartości można podać ścieżkę bezwzględną pliku: DATABASE_URL_FILE, CURSOR_KEY_FILE, FIELD_ENCRYPTION_KEYS_FILE, SYNC_CURSOR_KEYS_FILE, LOGIN_THROTTLE_KEY_FILE,
# EVIA_RELEASE_MANIFEST_SHA256_FILE, DELETION_REGISTER_S3_SECRET_ACCESS_KEY_FILE (tylko te klucze; jeden końcowy znak nowej linii jest usuwany, plik do 64 KiB). Ustawienie naraz
# zmiennej i jej _FILE, ścieżka względna albo nieczytelny plik = błąd startu (z nazwą zmiennej, bez wartości).

# --- Media: zdjecia zlecen (EVM-044; ADR-0009) — WSZYSTKO ALBO NIC ---
# Bez zadnej z ponizszych zmiennych wysylanie plikow odpowiada 503 media_storage_unavailable, a usluga pozostaje zdrowa (fail-closed).
# Czesc zmiennych bez pozostalych = blad startu (z nazwa zmiennej). Sekret na stagingu tylko z pliku: MEDIA_S3_SECRET_ACCESS_KEY_FILE.
# S3_ENDPOINT i S3_REGION sa wspolne z rejestrem usuniec (wyzej) i same nie wlaczaja mediow.
MEDIA_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# true tylko dla serwera S3 testow (path-style); Scaleway: false (adresowanie virtual-hosted, CSP przypina host bucketu).
S3_FORCE_PATH_STYLE=false
# Adres clamd: tcp://host:port (staging: kontener w sieci evia-scan) albo unix:///sciezka. Bez niego pliki nigdy nie staja sie clean.
CLAMD_SOCKET=
# Dokladnie jeden origin https bucketu dla CSP connect-src panelu (bez sciezki i wildcardow); pusty = tylko 'self'.
MEDIA_BUCKET_ORIGIN=
# EVM-049: limity niedokonczonych mediow (pending_upload) i wiek porzuconego uploadu; puste = wartosc domyslna (200 / 500 / 7 dni).
# Zla wartosc (nie liczba calkowita z zakresu) = blad startu z nazwa zmiennej.
MEDIA_MAX_PENDING_PER_USER=
MEDIA_MAX_PENDING_PER_ORDER=
MEDIA_ABANDON_AFTER_DAYS=
